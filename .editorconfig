root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_size = 2

[*.{json}]
indent_size = 2

[*.{gradle,gradle.kts}]
indent_size = 4

[*.dart]
indent_size = 2

[Makefile]
indent_style = tab
