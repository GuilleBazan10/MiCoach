# =====================================================================
# MiCoach — Variables de entorno (copiar a .env y completar)
# =====================================================================
# Instrucciones:
#   1. Copia este archivo a `.env` (NO subas .env al repositorio).
#   2. Completa los valores que faltan (secretos marcados con "generar").
#   3. Genera los secretos con:  openssl rand -base64 48   (o PowerShell:
#      [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256})))
# =====================================================================

# ------------------------------ Base de datos ------------------------------
POSTGRES_DB=micoach
POSTGRES_USER=micoach
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432
# prefer = usa SSL si el server lo soporta (Supabase), sin romper Postgres local
# sin SSL. En producción contra Supabase se puede forzar a "require".
POSTGRES_SSLMODE=prefer

# -------------------------------- Redis ------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------- RabbitMQ ----------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# -------------------------------- MinIO ------------------------------------
# Objetos: videos, imágenes, GIFs. Interfaz web: http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_MEDIA=media

# ------------------------------ OpenSearch ---------------------------------
# Infra OPCIONAL (docker-compose.full.yml)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# ------------------------------ Observabilidad ------------------------------
# Infra OPCIONAL (docker-compose.full.yml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# -------------------------------- Seguridad --------------------------------
# JWT: secreto aleatorio de mínimo 256 bits. Tiempos en milisegundos.
JWT_SECRET=generar_secreto_aleatorio_minimo_32_bytes
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
# AES para cifrar datos sensibles de salud (256 bits).
AES_SECRET=generar_secreto_aleatorio_minimo_32_bytes
# TOTP (2FA) — se puede dejar en blanco si no se configura email/QR.
TOTP_ISSUER=MiCoach

# ------------------------------- OAuth2 social ------------------------------
# IDs/secret de cada proveedor (Google Cloud Console, Apple Developer, Facebook Dev).
# Vacíos desactivan el botón de ese proveedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --------------------------- Email (recuperación) ---------------------------
# Cualquier SMTP (Gmail con app password, Mailtrap para desarrollo, etc.)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@micoach.app

# ------------------------------- Firebase ----------------------------------
# Push notifications. Ruta a la service account JSON (no subir al repo).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase.json

# ---------------------------------- IA -------------------------------------
# Proveedor por defecto si no hay ninguno activo en la tabla ai_provider_configs.
AI_PROVIDER=ollama
# Ollama (modelos locales gratuitos)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Las API keys de proveedores cloud (Groq, OpenRouter, Gemini) ya NO van acá:
# se cargan cifradas desde el panel de administración (/admin, tabla
# ai_provider_configs), reusando AES_SECRET de arriba para cifrarlas.
# Excepción: GROQ_API_KEY de acá abajo es solo un seed de arranque (ver
# GroqApiKeyBootstrap) — si la tabla ai_provider_configs no tiene ninguna key
# cargada para Groq todavía (ej. base recién creada), se toma de acá una sola vez
# y se guarda cifrada. Una vez cargada, /admin manda — esto no se vuelve a leer.
GROQ_API_KEY=

# ---------------------------------- CORS -----------------------------------
# Orígenes permitidos para la web (separar con coma). 5050 = `flutter run -d
# web-server --web-port=5050` (ver mobile/README.md); 5173 = `npm run dev` de
# la web React (puerto por defecto de Vite, ver web/README.md). Agregá el
# puerto real que uses si es distinto.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5050,http://localhost:5173

# ------------------------------- Spring ------------------------------------
# Perfil activo: dev | test | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
